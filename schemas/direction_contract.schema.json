{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-confirmed creative Direction Contract",
  "type": "object",
  "required": ["schema_version", "campaign", "status", "core_intent", "audience", "desired_viewer_shift", "creative_center", "tone", "must_communicate", "must_not_imply", "anti_direction", "success_tests", "open_freedoms", "unresolved_owner_decisions", "self_adversarial_check", "source_hashes"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT_AWAITING_OWNER", "OWNER_CONFIRMED", "INVALIDATED"]},
    "core_intent": {"type": "object", "minProperties": 1},
    "audience": {"type": "object", "minProperties": 1},
    "desired_viewer_shift": {"type": "object", "minProperties": 1},
    "creative_center": {"type": "object", "minProperties": 1},
    "tone": {"type": "object", "minProperties": 1},
    "must_communicate": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["statement", "evidence_refs"], "properties": {"statement": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "must_not_imply": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "anti_direction": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "success_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "open_freedoms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unresolved_owner_decisions": {"type": "array"},
    "self_adversarial_check": {"type": "object", "required": ["strongest_countercase", "disposition"]},
    "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
    "confirmed_by": {"type": "string"},
    "confirmed_at": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
